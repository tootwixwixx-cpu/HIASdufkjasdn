# Copy to .env.local (local) and set the same names in Vercel (Production). NEVER commit real values.

# --- Supabase (server only) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# service_role / secret key. Server-side ONLY. Never expose this in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin auth (all three are required; the app refuses admin login if any is missing) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=          # long + unique
AUTH_SECRET=             # >= 32 random bytes; rotating this logs everyone out

# --- Admin hardening (all optional) ---
# Two-factor: generate with `node migration/make-totp-secret.mjs`. When set, login requires a 6-digit code.
# NOTE: the mobile app's login has no code field yet — leave unset until it does, or the app can't sign in.
# ADMIN_TOTP_SECRET=
# Absolute admin session lifetime in hours (default 24). Sessions are revocable server-side (logout / sign out everywhere).
# ADMIN_SESSION_HOURS=24
# Browser origins allowed to call the API cross-origin (comma separated). Default: same-origin only.
# ALLOWED_ORIGINS=https://admin.example.com

# --- In-game hub telemetry relay (the Discord webhook now lives ONLY here, not in client Lua) ---
# HUB_TELEMETRY_WEBHOOK_URL=

# --- Anti-bypass / checkpoints (required; tokens are refused if empty) ---
ANTI_BYPASS_SECRET=      # >= 32 random bytes
WORKINK_API_KEY=

# --- Cron ---
CRON_SECRET=             # Vercel sends this as "Authorization: Bearer <value>" to /api/cron/prune

# --- Discord bot (used by discord-bot/, NOT stored in the database any more) ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# --- Only set when running behind your own reverse proxy that overwrites x-forwarded-for.
# Leave UNSET on Vercel. ---
# TRUSTED_PROXY=true
